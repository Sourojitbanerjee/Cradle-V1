# Cradle Control Plane Configuration

# Server
PORT=8080
LOG_LEVEL=info
APP_ENV=development

# Database (PostgreSQL 16)
DATABASE_URL=postgres://cradle_user:cradle_secure_password_dev@localhost:5432/cradle_db?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis (Task Queue & Caching)
REDIS_URL=redis://localhost:6379/0

# AWS Control Plane Identity (The AWS Account hosting Cradle's backend)
# This account ID is embedded in customer IAM Trust Policies
CRADLE_AWS_ACCOUNT_ID=000000000000

# Audit Log Chaining Secret (HMAC-SHA256 master key for tamper verification)
AUDIT_HMAC_SECRET=cradle-dev-insecure-hmac-secret-change-in-production-min32chars
